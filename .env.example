# Local development only. Run: uv run python scripts/init_local_env.py
# The script generates real local values in an ignored .env; never commit that file.
# An older .env can be completed with: uv run python scripts/init_local_env.py --add-missing
POSTGRES_PASSWORD=replace-with-generated-local-secret
POSTGRES_OWNER_PASSWORD=replace-with-generated-local-secret
POSTGRES_APP_PASSWORD=replace-with-generated-local-secret
POSTGRES_WORKER_PASSWORD=replace-with-generated-local-secret
QUOTATION_DATABASE_URL=postgresql+psycopg://quotation_app:replace-with-generated-local-secret@127.0.0.1:55432/quotation_dev
QUOTATION_MIGRATION_DATABASE_URL=postgresql+psycopg://quotation_owner:replace-with-generated-local-secret@127.0.0.1:55432/quotation_dev
QUOTATION_WORKER_DATABASE_URL=postgresql+psycopg://quotation_worker:replace-with-generated-local-secret@127.0.0.1:55432/quotation_dev
QUOTATION_ENVIRONMENT=development
# Optional: where attachments are stored locally (default var/storage, ignored by Git)
# QUOTATION_STORAGE_DIR=var/storage
# Optional: AI enquiry reader. Unset = free offline rules (no AI). Any LangChain chat model as
# "<provider>:<model>"; its LangChain package must be in the "ai" extra (uv sync --extra ai).
# Example, Google Gemini free tier (synthetic/demo data only: the free tier may use prompts to
# improve Google's products). Never commit the key.
# QUOTATION_MODEL=google_genai:gemini-3.5-flash-lite
# QUOTATION_MODEL_API_KEY=<your key>
# QUOTATION_MODEL_OPTIONS={"timeout": 60, "max_retries": 2}
