{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["quotation_app.api.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": { "QUOTATION_PORTAL_DIST_DIR": "portal/dist" },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "quotation_app.worker",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Portal (vite :5173)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/portal",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Demo page (:8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server:app", "--app-dir", "demo", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://[0-9.:]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Run all (DB + API + worker + portal)",
      "configurations": ["API (uvicorn :8000)", "Worker", "Portal (vite :5173)"],
      "preLaunchTask": "dev: prepare",
      "stopAll": true
    },
    {
      "name": "Demo (DB + API + worker + demo page)",
      "configurations": ["API (uvicorn :8000)", "Worker", "Demo page (:8001)"],
      "preLaunchTask": "demo: prepare",
      "stopAll": true
    }
  ]
}
